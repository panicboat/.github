{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":separateMajorReleases",
    "group:monorepos",
    "group:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "semanticCommitScope": "{{packageFileDir}}",
  "timezone": "Asia/Tokyo",
  "labels": [
    "🤖 renovate"
  ],
  "assigneesFromCodeOwners": false,
  "reviewersFromCodeOwners": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 5,
  "branchPrefix": "renovate/",
  "rangeStrategy": "bump",
  "schedule": [
    "* 21-23 * * 0-4",
    "* 0-8 * * 1-5"
  ],
  "minimumReleaseAge": "1 day",
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "Default: separate PRs per package",
      "groupName": "{{packageFileDir}}/{{depName}}",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "🚫 Major updates - disable automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "📈 major-update"
      ]
    },
    {
      "description": "Shared workflows from panicboat/.github apply without waiting for a release age",
      "matchPackageNames": [
        "panicboat/.github"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "🚫 Production environments - disable automerge",
      "matchFileNames": [
        "**/production/**"
      ],
      "automerge": false,
      "prPriority": -1,
      "addLabels": [
        "⚠️ production"
      ]
    },
    {
      "description": "✅ Minor/Patch updates - enable automerge",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}
